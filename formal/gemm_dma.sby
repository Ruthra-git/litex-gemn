[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 8
bmc: mode bmc
bmc: depth 100
cover: mode cover
cover: depth 120

[engines]
smtbmc boolector

[script]
prove: read_verilog -formal gemm_dma.v
bmc: read_verilog -formal -DF_PROGRESS gemm_dma.v
cover: read_verilog -formal -DF_PROGRESS -DF_KMAX=2 gemm_dma.v
chparam -set TIMEOUT 2 gemm_dma
prep -top gemm_dma

[files]
../rtl/gemm_dma.v
gemm_dma_props.vh
